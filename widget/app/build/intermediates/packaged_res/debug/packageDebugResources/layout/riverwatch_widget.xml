<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/boat_image"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="-4dp"
        android:layout_marginBottom="2dp"
        android:alpha="0.38"
        android:scaleType="fitCenter"
        android:src="@drawable/boat_headwind" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RV Koru"
            android:textColor="@color/rw_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="2dp"
            android:text="" />

        <TextView
            android:id="@+id/dday_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.035"
            android:maxLines="1"
            android:text="D-—"
            android:textColor="@color/rw_white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ETA —"
            android:textColor="@color/rw_muted"
            android:textSize="10sp" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="STATE"
                android:textColor="@color/rw_muted"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="SYNC..."
                android:textColor="@color/rw_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="TREND"
                android:textColor="@color/rw_muted"
                android:textSize="7sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/rw_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/last_update_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:includeFontPadding="false"
        android:text="UPDATED —"
        android:textColor="@color/rw_muted"
        android:textSize="7sp"
        android:textStyle="bold" />

</FrameLayout>
